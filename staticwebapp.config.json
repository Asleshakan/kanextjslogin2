{
  "navigationFallback": {
    "rewrite": "/",
    "exclude": ["/api/*", "/_next/*", "/static/*", "/favicon.ico", "/manifest.json"]
  },
  "routes": [
    {
      "route": "/api/auth/*",
      "rewrite": "/api/auth",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/logout",
      "headers": {
        "Cache-Control": "no-store, must-revalidate"
      }
    },
    {
      "route": "/*",
      "headers": {
        "Cache-Control": "no-store, must-revalidate"
      }
    }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "enabled": false
      },
      "github": {
        "enabled": false
      },
      "google": {
        "enabled": false
      },
      "twitter": {
        "enabled": false
      }
    }
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
